# --- Database (Supabase) ---
# Vercel: use the transaction pooler URL (port 6543). GitHub Actions: pooler or direct (5432).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Supabase Auth (admin sign-in only) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated owner emails allowed into /admin
ADMIN_EMAILS=

# --- Anthropic (pipeline only; GitHub Actions secret) ---
ANTHROPIC_API_KEY=
# Optional model overrides (defaults: haiku for triage/search/research, opus for drafting)
# MODEL_TRIAGE=claude-haiku-5-5
# MODEL_DRAFT=claude-opus-5-5
# DRAFT_EFFORT=medium

# --- Site ---
SITE_URL=https://designwell.co
# Salt for hashing submitter IPs (rate limiting)
SUBMISSION_SALT=

# --- Local development only ---
# ADMIN_DEV_BYPASS=1   # open /admin without Supabase when NODE_ENV=development
